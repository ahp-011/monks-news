---
import { layoutPaper } from '../lib/paper/layout';
import '../lib/paper/paper.css';
import type { Issue } from '../lib/data';
const { issue } = Astro.props as { issue: Issue };
const p = layoutPaper(issue);
const title = `DM Bytes · ${p.no}, ${p.longDate}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={`DM Bytes, the morning paper from Monks News: ${issue.headline}`} />
  <meta name="theme-color" content="#d8d4cc" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
</head>
<body>
  <a class="home" href="/">← Monks News</a>
  <div class="stage" id="stage">
    <div class="scaler" id="scaler">
      <div class="book is-closed-front" id="book" data-labels={JSON.stringify(p.labels)}><div class="shadow shadow--l"></div><div class="shadow shadow--r"></div><div class="edgewrap edgewrap--l"><div class="edge edge--l" id="edgeL"></div></div><div class="edgewrap edgewrap--r"><div class="edge edge--r" id="edgeR"></div></div><Fragment set:html={p.leaves} /></div>
    </div>
  </div>
  <nav class="bar" aria-label="Turn pages">
    <button type="button" id="prev" aria-label="Previous page">←</button>
    <div class="dots" id="dots" aria-hidden="true"></div>
    <span class="hint" id="hint" aria-live="polite">Cover</span>
    <button type="button" id="next" aria-label="Next page">→</button>
    <button type="button" id="snd" class="snd" aria-label="Turn page sound off" aria-pressed="true">♪</button>
  </nav>
  <script is:inline>
  (function () {
    var book = document.getElementById('book');
    var leaves = [].slice.call(book.querySelectorAll('.leaf'));
    var labels = JSON.parse(book.dataset.labels || '[]');
    var n = leaves.length, s = 0;
    var dots = document.getElementById('dots'), hint = document.getElementById('hint');
    var prev = document.getElementById('prev'), next = document.getElementById('next');
    var phone = function () { return matchMedia('(max-width: 899px)').matches; };
    for (var i = 0; i <= n; i++) dots.appendChild(document.createElement('i'));
    function render(moving) {
      leaves.forEach(function (l, k) { var f = k < s; l.classList.toggle('flipped', f); l.style.zIndex = k === moving ? n + 2 : (f ? k + 1 : n - k); });
      book.classList.toggle('is-closed-front', s === 0);
      book.classList.toggle('is-closed-back', s === n);
      [].forEach.call(dots.children, function (d, k) { d.classList.toggle('on', k === s); });
      hint.textContent = labels[s] || '';
      prev.disabled = s === 0; next.disabled = s === n;
      var eL = document.getElementById('edgeL'), eR = document.getElementById('edgeR');
      eL.style.setProperty('--w', (s > 1 ? Math.min(14, (s - 1) * 2.2 + 2) : 0) + 'px');
      eR.style.setProperty('--w', (s < n - 1 ? Math.min(14, (n - s - 1) * 2.2 + 2) : 0) + 'px');
      if (moving != null) {
        var ml = leaves[moving]; ml.classList.add('turning');
        setTimeout(function () { ml.classList.remove('turning'); }, 520);
        setTimeout(function () { render(); }, 960);
      }
    }
    // ---- page-turn sound: synthesised paper (a single airy swish as the page turns) ----
    var ac = null, noise = null, turns = 0, soundOn = true;
    try { soundOn = localStorage.getItem('dmb-sound') !== 'off'; } catch (e) {}
    var sndBtn = document.getElementById('snd');
    function syncSnd() { sndBtn.setAttribute('aria-pressed', String(soundOn)); sndBtn.setAttribute('aria-label', soundOn ? 'Turn page sound off' : 'Turn page sound on'); sndBtn.classList.toggle('off', !soundOn); }
    syncSnd();
    sndBtn.addEventListener('click', function () { soundOn = !soundOn; try { localStorage.setItem('dmb-sound', soundOn ? 'on' : 'off'); } catch (e) {} syncSnd(); if (soundOn) flipSound(1); });
    function rnd(seed) { var x = Math.sin(seed * 9301 + 49297) * 233280; return x - Math.floor(x); }
    function audio() {
      if (!ac) {
        var AC = window.AudioContext || window.webkitAudioContext; if (!AC) return null;
        ac = new AC();
        noise = ac.createBuffer(1, ac.sampleRate * 2, ac.sampleRate);
        var d = noise.getChannelData(0), b0 = 0, b1 = 0;
        for (var i = 0; i < d.length; i++) { var w = Math.random() * 2 - 1; b0 = 0.97 * b0 + 0.03 * w; b1 = 0.6 * b1 + 0.4 * w; d[i] = (w * 0.55 + b1 * 0.35 + b0 * 0.6); } // mix of white and softer noise: paper fibre
      }
      if (ac.state === 'suspended') ac.resume();
      return ac;
    }
    function burst(t, dur, f, q, gain, pan, attack) {
      var src = ac.createBufferSource(); src.buffer = noise;
      var bp = ac.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = f; bp.Q.value = q;
      var g = ac.createGain(); g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(gain, t + (attack || 0.004)); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      var p = ac.createStereoPanner ? ac.createStereoPanner() : null;
      src.connect(bp); bp.connect(g); if (p) { p.pan.value = pan; g.connect(p); p.connect(out); } else g.connect(out);
      src.start(t, Math.random() * 1.5, dur + 0.05);
      return { bp: bp, g: g };
    }
    var out = null;
    function flipSound(dir) {
      if (!soundOn || !audio()) return;
      if (!out) { out = ac.createGain(); out.gain.value = 0.9; var comp = ac.createDynamicsCompressor(); out.connect(comp); comp.connect(ac.destination); }
      var t0 = ac.currentTime + 0.01, k = ++turns, side = dir > 0 ? 1 : -1;
      // 2. the page sweeps over: an airy swish that rises then falls, travelling across the stereo field
      var sw = burst(t0 + 0.05, 0.62, 900, 0.8, 0.0001, side * 0.4, 0.01);
      sw.g.gain.cancelScheduledValues(t0); sw.g.gain.setValueAtTime(0.0001, t0 + 0.05);
      sw.g.gain.exponentialRampToValueAtTime(0.28, t0 + 0.32); sw.g.gain.exponentialRampToValueAtTime(0.0001, t0 + 0.72);
      sw.bp.frequency.setValueAtTime(700, t0 + 0.05); sw.bp.frequency.exponentialRampToValueAtTime(2600 + rnd(k) * 900, t0 + 0.3); sw.bp.frequency.exponentialRampToValueAtTime(1100, t0 + 0.7);
    }
    function go(d) { var t = Math.max(0, Math.min(n, s + d)); if (t === s) return; var m = d > 0 ? s : t; s = t; flipSound(d); render(m); }
    prev.addEventListener('click', function () { go(-1); });
    next.addEventListener('click', function () { go(1); });
    leaves.forEach(function (l, k) { l.addEventListener('click', function (e) { if (e.target.closest('a') || phone()) return; go(k < s ? -1 : 1); }); });
    addEventListener('keydown', function (e) { if (e.key === 'ArrowRight' || e.key === 'PageDown') go(1); if (e.key === 'ArrowLeft' || e.key === 'PageUp') go(-1); });
    var x0 = null;
    addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
    addEventListener('touchend', function (e) { if (x0 == null || phone()) return; var dx = e.changedTouches[0].clientX - x0; x0 = null; if (Math.abs(dx) > 50) go(dx < 0 ? 1 : -1); });
    var scaler = document.getElementById('scaler');
    function fit() {
      if (phone()) { scaler.style.transform = ''; return; }
      var k = Math.min((innerWidth - 48) / 1200, (innerHeight - 110) / 840);
      scaler.style.transform = 'scale(' + Math.max(0.3, k * 0.97) + ')';
    }
    // shrink type a little on any page that still runs long
    function fitPages() {
      if (phone()) return;
      document.querySelectorAll('.pg').forEach(function (pg) {
        var t = pg.querySelector(':scope > .push, :scope > .push2') || pg, z = 1;
        t.style.zoom = '';
        while (pg.scrollHeight > pg.clientHeight + 1 && z > 0.8) { z -= 0.03; t.style.zoom = z; }
      });
    }
    // poster words always fit their block, never cropped
    function fitPosters() {
      document.querySelectorAll('.poster__w').forEach(function (w) {
        var box = w.parentElement; w.style.fontSize = '';
        var fs = parseFloat(getComputedStyle(w).fontSize);
        for (var i = 0; i < 30 && (w.scrollWidth > box.clientWidth * 0.94 || w.offsetHeight > box.clientHeight * 1.02); i++) { fs *= 0.94; w.style.fontSize = fs + 'px'; }
      });
    }
    // artwork fills leftover space; drop it where the gap is too small to read as a picture
    function fitArt() {
      document.querySelectorAll('.fill-art').forEach(function (a) { a.hidden = false; if (!phone() && a.getBoundingClientRect().height / (a.closest('.page').getBoundingClientRect().height / 840) < 70) a.hidden = true; });
    }
    function layout() { fitPages(); fitPosters(); fitArt(); }
    addEventListener('resize', function () { fit(); fitPosters(); }); fit(); render();
    (document.fonts ? document.fonts.ready : Promise.resolve()).then(layout);
  })();
  </script>
</body>
</html>
