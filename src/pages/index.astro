---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import TeamTag from '../components/TeamTag.astro';
import { latest, issues, allStories, SECTIONS, sectionCounts, fmt, url } from '../lib/data';

const issue = latest;
const featured = issue.stories.filter((s) => s.featured).slice(0, 3);
const [lead, ...side] = featured.length ? featured : issue.stories.slice(0, 3);
const more = issue.stories.filter((s) => !s.featured && ['industry', 'design-ux', 'branding', 'development', 'ai-engineering', 'inspiration', 'trends'].includes(s.section));
const earlier = issues.slice(1, 7);
const tools = [...issue.tools].sort((a, b) => b.rating - a.rating);
const total = issue.stories.length + issue.tools.length;
const storyTeam = (id: string) => issue.stories.find((s) => s.id === id)?.team ?? 'both';
---
<Base active="today">
  <section class="wrap hero">
    <div class="hero__top">
      <div>
        <p class="label reveal">{fmt.no(issue.number)} &nbsp; {fmt.long(issue.date)}</p>
        <h1 data-reveal="text">Design and development news, read for <em>the Monks.</em></h1>
      </div>
      <div class="hero__aside reveal" style="--d:200ms">
        <p>A new brief every morning at 9:00, Dhaka. Today's issue has {total} stories, from the industry to tools worth trying, for Design Monks and Dev Monks.</p>
        <div class="hero__btns">
          <a class="btn" href={url.issue(issue.date)}>Read today's issue <span class="arrow">→</span></a>
          <a class="btn btn--secondary" href="/archive/">Search the archive</a>
        </div>
      </div>
    </div>

    <div class="feature">
      <a class="card card--lead reveal" href={url.story(issue.date, lead.id)} data-team={lead.team}>
        <Art seed={lead.id} team={lead.team} reveal cols={12} rows={6} />
        <div class="card__body">
          <TeamTag team={lead.team} section={lead.section} />
          <h2 class="card__title">{lead.title}</h2>
          <p class="summary clamp2">{lead.summary}</p>
        </div>
      </a>
      <div class="feature__side" data-stagger="120">
        {side.map((s) => (
          <a class="card reveal" href={url.story(issue.date, s.id)} data-team={s.team}>
            <Art seed={s.id} team={s.team} reveal cols={9} rows={3} />
            <div class="card__body">
              <TeamTag team={s.team} section={s.section} />
              <h2 class="card__title">{s.title}</h2>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div class="brief" id="in-brief">
      <div class="brief__intro reveal">
        <p class="label" style="margin:0">01 / In brief</p>
        <h2 class="h2">Five things to know today.</h2>
        <p>The short version of the issue. Each one opens the full story with its sources.</p>
        <a class="btn btn--tertiary" href={url.issue(issue.date)}>Read the full issue <span class="arrow">→</span></a>
      </div>
      <ol class="brief__list" data-stagger="70">
        {issue.brief.map((b, i) => (
          <li class="reveal" data-team={storyTeam(b.story)}>
            <a href={url.story(issue.date, b.story)}>
              <span class="label">0{i + 1}</span>
              <span><h3>{b.title}</h3><p>{b.text}</p></span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <div class="sec-head">
        <div class="reveal"><p class="label">02 / More from today</p><h2>Design, development and the industry.</h2></div>
        <a class="btn btn--tertiary reveal" href={url.issue(issue.date)}>All {total} stories <span class="arrow">→</span></a>
      </div>
      <div class="grid3" data-stagger="90">
        {more.slice(0, 9).map((s) => (
          <a class="tile reveal" href={url.story(issue.date, s.id)} data-team={s.team}>
            <Art seed={s.id} team={s.team} reveal />
            <TeamTag team={s.team} section={s.section} />
            <h3>{s.title}</h3>
            <p class="summary clamp2">{s.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--band">
    <div class="wrap">
      <div class="sec-head">
        <div class="reveal"><p class="label">03 / Tools worth trying</p><h2>Today's tools, rated out of ten.</h2></div>
        <div class="sec-head__aside reveal">
          <p class="muted">What each one does and who it helps, best first. Every rating ever given lives on the tools page.</p>
          <a class="btn btn--invert" href="/tools/">See every rated tool</a>
        </div>
      </div>
      <div class="tool-list" data-stagger="70">
        {tools.map((t) => (
          <a class="tool-row reveal" href={url.story(issue.date, t.id)} data-team={t.team}>
            <Art seed={t.id} team={t.team} cols={5} rows={3} />
            <div>
              <h3>{t.name} <span class="score">{t.rating}/10</span><span class="score"><span class={`dot dot--${t.team}`}></span> {t.team === 'both' ? 'Both' : t.team === 'design' ? 'Design' : 'Dev'}</span></h3>
              <p class="muted">{t.text}</p>
            </div>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <div class="reveal"><p class="label">04 / Earlier issues</p><h2>The archive, a day at a time.</h2></div>
        <a class="btn btn--tertiary reveal" href="/archive/">Open the archive <span class="arrow">→</span></a>
      </div>
      {earlier.length ? (
        <div class="arch-rows" data-stagger="60">
          {earlier.map((i) => (
            <a class="arch-row reveal" href={url.issue(i.date)}>
              <span class="label">{fmt.short(i.date)}</span>
              <h3>{i.headline}</h3>
              <span class="no">{fmt.no(i.number).toUpperCase()}</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="arch-rows">
          <div class="arch-row"><span class="label">{fmt.short(issue.date)}</span><h3>This is the first issue. Earlier issues will appear here each morning.</h3><span class="no">{fmt.no(issue.number).toUpperCase()}</span></div>
        </div>
      )}
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <div class="sec-head"><div class="reveal"><p class="label">05 / Sections</p><h2>Browse by section.</h2></div></div>
      <div class="secs" data-stagger="50">
        {SECTIONS.map((s) => (
          <a class="sec-tile reveal" href={url.section(s.key)}>
            <Art seed={`section-${s.key}`} team={['design-ux', 'branding', 'inspiration'].includes(s.key) ? 'design' : ['development', 'ai-engineering', 'open-source'].includes(s.key) ? 'dev' : 'both'} cols={4} rows={3} />
            <span class="sec-tile__row"><span>{s.label}</span><span class="label">{sectionCounts[s.key]}</span></span>
          </a>
        ))}
        <a class="sec-tile reveal" href="/archive/">
          <Art seed="section-all" team="both" cols={4} rows={3} />
          <span class="sec-tile__row"><span>Every story</span><span class="label">{allStories.length}</span></span>
        </a>
      </div>
    </div>
  </section>
</Base>
